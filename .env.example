# Copy this file to .env (it is ignored by Git) and set the password and the key.
# Docker Compose reads .env automatically. Variables set in the shell win over .env.
# A value with a dollar sign or a hash sign must be put in single quotes, for example
# DB_PASSWORD='pa$$word#1': otherwise Compose treats "$" as a variable and cuts the value at "#".
DB_NAME=order_service_db
DB_USERNAME=order_service
DB_PASSWORD=change-me

# The shared key of the internal endpoints (header X-Internal-Key). The Order Service only sends
# it to the User Service, so it must be the same value as INTERNAL_API_KEY of the User Service
# (and of the Authentication Service). Generate one with:
#   openssl rand -base64 32
INTERNAL_API_KEY=change-me-internal-key

# Optional. The default is authentication-service. The issuer must be the same as JWT_ISSUER of
# the Authentication Service.
#JWT_ISSUER=authentication-service

# Optional. The internal addresses of the other services. The defaults of the standalone Compose
# are the services on the host (http://host.docker.internal:8081 and :8082); in the Compose of
# the whole system they are http://authentication-service:8081 and http://user-service:8082.
#AUTH_JWKS_URI=http://host.docker.internal:8081/.well-known/jwks.json
#USER_SERVICE_URI=http://host.docker.internal:8082
